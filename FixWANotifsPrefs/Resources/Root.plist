<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>TWEAK STATUS</string>
			<key>footerText</key>
			<string>Enable or disable the WhatsApp notification fix</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Tweak Enabled</string>
			<key>key</key>
			<string>Enabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.0xkuj.fixwanotifsprefs</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>JETSAM MEMORY LIMIT</string>
			<key>footerText</key>
			<string>The memory ceiling for WhatsApp's notification extension. Higher gives more headroom, but use the smallest value that delivers notifications reliably. 40 MB is enough for most accounts; raise it only if notifications still drop.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>key</key>
			<string>JetsamLimit</string>
			<key>default</key>
			<integer>40</integer>
			<key>defaults</key>
			<string>com.0xkuj.fixwanotifsprefs</string>
			<key>validTitles</key>
			<array>
				<string>40 MB</string>
				<string>72 MB</string>
				<string>96 MB</string>
			</array>
			<key>validValues</key>
			<array>
				<integer>40</integer>
				<integer>72</integer>
				<integer>96</integer>
			</array>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>APPLY</string>
			<key>footerText</key>
			<string>Changing the switch or the memory limit only takes effect after a userspace reboot. Tap Apply to save and reboot now.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Apply &amp; Reboot</string>
			<key>action</key>
			<string>applyAndReboot</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>ABOUT ME</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>icon</key>
			<string>donate.png</string>
			<key>label</key>
			<string>Buy me a beer ;)</string>
			<key>action</key>
			<string>openDonate</string>
		</dict>
		<dict>
			<key>action</key>
			<string>openTwitter</string>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>icon</key>
			<string>Twitter.png</string>
			<key>label</key>
			<string>Follow me on Twitter</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>icon</key>
			<string>GitHub.png</string>
			<key>label</key>
			<string>Source Code (GitHub)</string>
			<key>action</key>
			<string>openGithub</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Made by: 0xkuj | v1.1.0</string>
		</dict>
	</array>
	<key>title</key>
	<string>FixWANotifs</string>
</dict>
</plist>
